# Copy this file to services/verifier/.env for local runs and fill in your own values.
# .env is ignored by git: your keys never leave your computer.
#
# On Render there is no .env file: put these same names and values in the service's
# Environment settings instead (Dashboard -> your service -> Environment).

# --- The token the orchestrator must send (Authorization: Bearer <token>) ---
# Make one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a DIFFERENT token from the researcher's. The orchestrator's .env needs a copy of this one.
VERIFIER_TOKEN=

# --- Model (one is enough; with provider: auto the first one set is used) ---
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free Groq key (backup option): https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional ---
# Where to also write the trace log (it is always printed). Default: traces/verifier.jsonl in the project folder.
# TRACE_FILE=
