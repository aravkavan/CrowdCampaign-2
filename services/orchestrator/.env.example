# Copy this file to services/orchestrator/.env and fill in your own values.
# .env is ignored by git: your secrets never leave your computer.

# --- Where the two workers are ---
# Locally: leave these two lines out (the defaults are http://localhost:8001 and http://localhost:8002).
# Deployed: the https address Render gave you. http:// is only accepted for localhost.
RESEARCHER_URL=
VERIFIER_URL=

# --- The secret token each worker expects (Authorization: Bearer <token>) ---
# Make one for each:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# They must be DIFFERENT from each other. Each must match the token that worker was started with
# (services/researcher/.env and services/verifier/.env, or Render's Environment settings for the verifier).
RESEARCHER_TOKEN=
VERIFIER_TOKEN=

# --- The CrowdCampaign app (where run history and last run's top list are kept) ---
# The orchestrator talks to the app's API, never to the database. It logs in as this user, and the runs
# show up when you log in to the app as the same user.
# These are the course's public grader credentials, not a personal secret (the same ones the 1B tracker used).
# That way the graders see the runs when they log in as the grader.
CROWDCAMPAIGN_API_URL=http://localhost:4000
TRACKER_USERNAME=NYUgrader
TRACKER_PASSWORD=Courant2026!

# --- Set by the website, never by you ---
# When the head person presses "Research this campaign", the site's server starts this program with a short-lived
# login token in TRACKER_TOKEN (for that one person). Do NOT put TRACKER_TOKEN in this file. The keys above are still
# read from this file, so the site never sees them.

# --- Optional ---
# Where to write the orchestrator's trace log. Default: traces/orchestrator.jsonl in the project folder.
# TRACE_FILE=
