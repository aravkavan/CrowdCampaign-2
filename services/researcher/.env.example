# Copy this file to services/researcher/.env and fill in your own values.
# .env is ignored by git: your keys never leave your computer.

# --- The token the orchestrator must send (Authorization: Bearer <token>) ---
# Make one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a DIFFERENT token from the verifier's. The orchestrator's .env needs a copy of this one.
RESEARCHER_TOKEN=

# --- Model (one is enough; with provider: auto the first one set is used) ---
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free Groq key (backup option): https://console.groq.com/keys
GROQ_API_KEY=

# --- Web search ---
# Free Tavily key (1,000 credits a month): https://app.tavily.com
TAVILY_API_KEY=

# --- Optional ---
# Where to also write the trace log (it is always printed). Default: traces/researcher.jsonl in the project folder.
# TRACE_FILE=
