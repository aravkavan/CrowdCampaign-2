# Every variable the backend reads, with example values.
#
#   .env        committed; throwaway database URL + non-secret settings only
#   .env.local  git-ignored; your personal keys (loaded first, so it wins)

# PostgreSQL connection string (Neon, Supabase, Render or local Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Port the API listens on. If you change it, change VITE_API_URL in frontend/.env too.
PORT=4000

# Browser origins allowed to call the API (CORS), comma-separated, no spaces needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# How long a login token stays valid, in seconds (7200 = 2 hours).
TOKEN_TTL_SECONDS=7200

# Optional. Key used to sign login tokens; at least 32 characters.
# Leave it unset locally: the server creates one on first start and keeps it in
# backend/.secrets/jwt-secret (git-ignored). Set it when you deploy.
# JWT_SECRET=

# AI judge (optional; the whole app works without it).
#   auto      Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
#             else the offline estimate (clearly labelled "not AI" in the app)
#   anthropic | gemini | offline   force one of them
AI_PROVIDER=auto

# Put real keys in backend/.env.local, never in .env.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Seconds to wait for one AI request before giving up (default 45).
# AI_TIMEOUT_SECONDS=45

# --- "Research this campaign" (the agent team, started from the website) ---
# The head person's Manage box can start the orchestrator in services/orchestrator on THIS computer.
# It needs Python with the packages from services/orchestrator/requirements.txt. If your packages live in a
# virtual environment, put the path to that environment's Python here (put it in .env.local, not .env):
#   Windows:  ORCHESTRATOR_PYTHON=C:\path\to\project\.venv\Scripts\python.exe
#   Mac:      ORCHESTRATOR_PYTHON=/path/to/project/.venv/bin/python
# Default: py on Windows (the Python launcher), python3 elsewhere.
# ORCHESTRATOR_PYTHON=

# Limits, because every run spends your model and search keys (config.yaml also caps each run's budget).
RESEARCH_COOLDOWN_SECONDS=600       # the team rests this long after every run (10 minutes)
RESEARCH_RUNS_PER_DAY=3             # runs one person may start in 24 hours
RESEARCH_MAX_RUNTIME_SECONDS=1500   # a run still going after this is stopped (25 minutes)
RESEARCH_ADMINS=NYUgrader           # usernames that may run the team on EVERY campaign (comma-separated).
                                    # Add yours in backend/.env.local:  RESEARCH_ADMINS=NYUgrader,yourname
