# Dependencies (npm install recreates them)
node_modules/

# Build output
dist/

# Personal secrets: never commit these
.env.local
.env.*.local
.secrets/
# Each service's own keys and tokens (model, search, bearer tokens, app login) live in its .env.
# The .env.example files next to them ARE committed; the real .env files are not.
services/*/.env

# Python
.venv/
venv/
__pycache__/
*.pyc

# NOTE: backend/.env and frontend/.env ARE committed on purpose (course requirement).
# They hold only the throwaway database URL and non-secret settings.
# services/*/.env is NOT committed: it holds personal API keys and tokens (see services/*/.env.example).

# System and editor clutter
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# A log copied from Render (turn it into traces/verifier.jsonl with scripts/extract_trace.py, then delete it)
render-log*.txt
